Parent = self(),
{module, klsn_bwrap_port} = code:ensure_loaded(klsn_bwrap_port),
Original = whereis(file_server_2),
Proxy = spawn(fun() -> Loop = fun F(Held, Pending) ->
    receive
        release ->
            Original ! Pending,
            Parent ! released,
            F(true, undefined);
        bypass ->
            case Pending of undefined -> ok; _ -> Original ! Pending end,
            Parent ! bypassed,
            F(true, undefined);
        Message = {'$gen_call', {Caller, _}, {read_file, Path}} ->
            IsStat = is_list(Path) andalso lists:prefix("/proc/", Path) andalso
                lists:suffix("/stat", Path),
            case not Held andalso IsStat of
                true -> Parent ! {stat_held, Caller, Path}, F(true, Message);
                false -> Original ! Message, F(Held, Pending)
            end;
        Message -> Original ! Message, F(Held, Pending)
    end
end, Loop(false, undefined) end),
unregister(file_server_2),
register(file_server_2, Proxy),
try
    Opts = #{bwrap => [{ro_bind, <<"/">>, <<"/">>}, {dev, <<"/dev">>},
        {proc, <<"/proc">>}, {tmpfs, <<"/tmp">>}]},
    BeforePorts = erlang:ports(),
    spawn(fun() ->
        Parent ! {opened, catch klsn_bwrap:open([<<"/bin/cat">>], Opts)},
        receive finish -> ok end
    end),
    {Worker, Helper, Path, Held} = receive
        {stat_held, Requester, File} ->
            [W] = [P || P <- processes(),
                process_info(P, initial_call) =:= {initial_call, {klsn_bwrap_port, init, 3}}],
            [_, H, _] = string:lexemes(File, "/"),
            [Port] = [P || P <- erlang:ports(),
                erlang:port_info(P, os_pid) =:= {os_pid, list_to_integer(H)}],
            io:format("held_identity_request=~p worker=~p connected=~p helper=~s~n",
                [Requester, W, erlang:port_info(Port, connected), H]),
            {W, H, File, true};
        {opened, #{exec_pid := W, os_pid := Wrapper}} ->
            %% Raw identity reads bypass the proxy: verify ownership after
            %% open instead of requiring the removed file-server call.
            Proxy ! bypass,
            receive bypassed -> ok after 3000 -> error(proxy_not_bypassed) end,
            {dictionary, Dict} = process_info(W, dictionary),
            Guardian = proplists:get_value(guardian, Dict),
            {initial_call, {klsn_bwrap_port, init_guardian, 2}} =
                process_info(Guardian, initial_call),
            New = [{P, N} || P <- erlang:ports() -- BeforePorts,
                {os_pid, N} <- [erlang:port_info(P, os_pid)]],
            true = length(New) >= 2,
            true = lists:all(fun({P, _}) ->
                erlang:port_info(P, connected) =:= {connected, Guardian}
            end, New),
            [] = [P || P <- erlang:ports(),
                erlang:port_info(P, connected) =:= {connected, W}],
            {ok, WrapperStat} = file:read_file("/proc/" ++ integer_to_list(Wrapper) ++ "/stat"),
            Supervisor = list_to_integer(lists:nth(2, string:lexemes(binary_to_list(
                lists:last(binary:split(WrapperStat, <<") ">>, [global]))), " "))),
            [{_Stdin, Hpid}] = [{P, N} || {P, N} <- New, N =/= Supervisor],
            H = integer_to_list(Hpid),
            io:format("guardian_owns_helpers worker=~p guardian=~p stdin=~s~n",
                [W, Guardian, H]),
            {W, H, "/proc/" ++ H ++ "/stat", false};
        {opened, Result} -> error({unexpected_open_result, Result})
    after 5000 -> error(no_startup_checkpoint)
    end,
    ok = file:write_file("/tmp/registration-helper", Helper),
    ok = file:write_file("/tmp/registration-vm", os:getpid()),
    Monitor = monitor(process, Worker),
    exit(Worker, kill),
    receive {'DOWN', Monitor, process, Worker, killed} -> ok
        after 3000 -> error(worker_not_killed) end,
    case Held of
        true -> Proxy ! release,
            receive released -> ok after 3000 -> error(identity_not_released) end;
        false -> ok
    end,
    Gone = fun F(N) ->
        case file:read_file(Path) of
            {error, enoent} -> true;
            _ when N > 0 -> timer:sleep(10), F(N - 1);
            _ -> false
        end
    end,
    ok = file:write_file("/tmp/registration-worker-cleanup", atom_to_list(Gone(500)))
after
    unregister(file_server_2),
    register(file_server_2, Original),
    exit(Proxy, kill)
end,
halt(0).
