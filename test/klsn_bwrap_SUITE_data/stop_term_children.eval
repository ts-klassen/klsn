process_flag(trap_exit, false),
Wait = fun F(Predicate, N) ->
    case Predicate() of
        true -> ok;
        false when N > 0 -> timer:sleep(10), F(Predicate, N - 1);
        false -> error(stop_cleanup_incomplete)
    end
end,
Alive = fun(Pid) ->
    case file:read_file("/proc/" ++ integer_to_list(Pid) ++ "/stat") of
        {ok, Stat} ->
            case string:lexemes(binary_to_list(lists:last(
                    binary:split(Stat, <<") ">>, [global]))), " \n") of
                [State | _] = Fields when length(Fields) >= 20 ->
                    not lists:member(State, ["Z", "X", "x"]);
                _ -> false
            end;
        {error, Reason} when Reason =:= enoent; Reason =:= esrch -> false
    end
end,
Signal = fun(Name, Pid) ->
    Port = open_port({spawn_executable, os:find_executable("kill")},
        [exit_status, hide, {args, [Name, "--", integer_to_list(Pid)]}]),
    receive {Port, {exit_status, 0}} -> ok
        after 1000 -> error({signal_failed, Name, Pid}) end,
    catch erlang:port_close(Port)
end,
lists:foreach(fun({Mode, Extra}) ->
    Opts = #{bwrap => [{ro_bind, <<"/">>, <<"/">>}, {dev, <<"/dev">>},
        {proc, <<"/proc">>}, {tmpfs, <<"/tmp">>},
        {bind, <<"/tmp/stop-checkpoint">>, <<"/tmp/stop-checkpoint">>} | Extra]},
    Command = <<"trap 'sleep 30 </dev/null >/dev/null 2>&1 & "
        "printf \"%s\\n\" \"$!\" >/tmp/stop-checkpoint/late; "
        "if [ \"$1\" = exit ]; then exit 7; fi; trap \"\" TERM' TERM; "
        "printf ready; while :; do sleep 30 & wait $!; done">>,
    Handle = #{exec_pid := Worker, os_pid := OsPid} = klsn_bwrap:open(
        [<<"/bin/bash">>, <<"-c">>, Command, <<"stop-term">>, atom_to_binary(Mode)], Opts),
    receive {stdout, OsPid, <<"ready">>} -> ok
        after 5000 -> error(command_not_ready) end,
    {dictionary, Dict} = process_info(Worker, dictionary),
    Guardian = proplists:get_value(guardian, Dict),
    WorkerMonitor = erlang:monitor(process, Worker),
    GuardianMonitor = erlang:monitor(process, Guardian),
    Native = [OsPid | [N || Port <- erlang:ports(),
        erlang:port_info(Port, connected) =:= {connected, Guardian},
        {os_pid, N} <- [erlang:port_info(Port, os_pid)]]],
    [Dir] = filelib:wildcard("/tmp/klsn-bwrap-" ++ os:getpid() ++ "-*"),
    %% Hold the bubblewrap monitor until the inner shell has created its
    %% TERM child. Otherwise cleanup can kill the shell before its trap runs.
    Signal("-STOP", OsPid),
    self() ! keep_this_message,
    Start = erlang:monotonic_time(millisecond),
    ok = klsn_bwrap:stop(Handle),
    true = erlang:monotonic_time(millisecond) - Start < 1000,
    Wait(fun() -> case file:read_file("/tmp/stop-checkpoint/late") of
        {ok, Bytes} -> byte_size(Bytes) > 0;
        _ -> false
    end end, 200),
    case Mode of
        exit -> Signal("-CONT", OsPid);
        %% Keeping the monitor stopped exercises five-second escalation.
        linger -> ok
    end,
    Collect = fun F() ->
        receive
            {stdout, OsPid, _} -> F();
            {stderr, OsPid, _} -> F();
            {'DOWN', OsPid, process, Worker, Reason} -> Reason
        after 7000 -> error(stop_did_not_complete)
        end
    end,
    %% The public status belongs to bubblewrap's monitor, which receives
    %% TERM even when the inner shell's trap returns a normal exit code.
    Expected = case Mode of exit -> {exit_status, 15}; linger -> {exit_status, 9} end,
    Expected = Collect(),
    receive {'DOWN', WorkerMonitor, process, Worker, Expected} -> ok
        after 1000 -> error(worker_still_alive) end,
    receive {'DOWN', GuardianMonitor, process, Guardian, normal} -> ok
        after 1000 -> error(guardian_still_alive) end,
    {ok, LateBytes} = file:read_file("/tmp/stop-checkpoint/late"),
    Late = list_to_integer(string:trim(binary_to_list(LateBytes))),
    Wait(fun() -> not Alive(Late) andalso
        lists:all(fun(Pid) -> not Alive(Pid) end, Native) andalso
        not filelib:is_dir(Dir)
    end, 200),
    receive keep_this_message -> ok after 0 -> error(unrelated_message_lost) end,
    {messages, []} = process_info(self(), messages),
    ok = file:delete("/tmp/stop-checkpoint/late")
end, [{Mode, Extra} || Mode <- [exit, linger], Extra <- [[], [new_session]]]),
io:format("TERM-created children removed; raw statuses preserved~n"),
halt(0).
